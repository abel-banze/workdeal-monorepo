# apps/api/.env — per-project (Vercel Root Directory = apps/api)
# Copie para apps/api/.env e preencha. NUNCA commite .env real.
# Em dev local, este ficheiro é lido por apps/api/src/load-env.ts (dotenv per-project)

DATABASE_URL=postgres://postgres:202604@localhost:5432/workdeeal_monorepo
BETTER_AUTH_SECRET=change-me-min-32-chars-secret-0123456789ABCD
BETTER_AUTH_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development
PORT=4000

# Google Maps Platform — UMA SÓ CHAVE alimenta os dois lados:
#  • apps/web/.env.local → NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (Maps JS: mapa + pin no browser)
#  • apps/api/.env       → a MESMA chave aqui, reutilizada pelo proxy /api/v1/places/*
# Basta activar "Places API (New)" na mesma key na consola do Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opcional — só se preferires uma chave dedicada ao Places (sobrepõe a acima)
GOOGLE_PLACES_API_KEY=

# Bias de pesquisa (opcional) — centro e raio do círculo de priorização.
# Default: Maputo (-25.9692, 32.5732), raio 50km
PLACES_BIAS_LAT=-25.9692
PLACES_BIAS_LNG=32.5732
PLACES_BIAS_RADIUS_KM=50

# Segredo partilhado web↔API — obrigatório em produção para POST /api/v1/email/*
# Tem de ser IGUAL ao INTERNAL_API_SECRET do web. Gerar: openssl rand -base64 32
INTERNAL_API_SECRET=

# Opcionais — conforme serviço activo
RESEND_API_KEY=
ZERNIO_API_KEY=
ZERNIO_PHONE_ID=
SMS_API_URL=https://my.turbo.host/api/international-sms/submit
SMS_USER_TOKEN=
# Cloudinary — upload de ficheiros
# Nomes canónicos abaixo; CLOUDINARY_URL ou aliases CLOUDINARY_NAME/API/SECRET também aceites
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=workdeal
