# Next carrega este ficheiro + .env.local. NUNCA commits chaves reais aqui — usa .env.local (git-ignored).
# Em produção (Vercel), define as mesmas variáveis no dashboard do projecto admin.

# URL pública da API Hono (onde vive o better-auth backend). Em produção: https://api.workdeal.co.mz
# Sem isto, o proxy /api/auth/* do admin tenta http://localhost:4000 e falha com AUTH_PROXY_ERROR.
BETTER_AUTH_URL=http://localhost:4000

# Mesma URL da API — usada em actions/utilitários.
API_URL=http://localhost:4000

# Segredo do better-auth — TEM DE SER IGUAL ao BETTER_AUTH_SECRET da API, senão os tokens são inválidos.
BETTER_AUTH_SECRET=
