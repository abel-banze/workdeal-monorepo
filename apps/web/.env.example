# Next carrega este ficheiro + .env.local. Mantém NEXT_PUBLIC_* para o browser.
# NUNCA commits chaves reais aqui — usa .env.local (git-ignored).
BETTER_AUTH_URL=http://localhost:4000

# Google Maps — expõe no browser para Maps JS + Places Autocomplete
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side (geocoding) — pode ser a mesma chave com restrições diferentes
GOOGLE_MAPS_API_KEY=

# Turbo.host SMS — OTP via SMS internacional (sender CODEBAZ)
SMS_API_URL=https://my.turbo.host/api/international-sms/submit
SMS_USER_TOKEN=

# Zernio WhatsApp — OTP via template verify_otp_usage
ZERNIO_PHONE_ID=
ZERNIO_API_KEY=

# Resend Email — OTP via email
RESEND_API_KEY=
API_URL=http://localhost:4000

# Segredo partilhado com a API para endpoints só-internos (POST /api/v1/email/*)
# Tem de ser IGUAL ao INTERNAL_API_SECRET da API. Gerar: openssl rand -base64 32
INTERNAL_API_SECRET=

# Site URL — usado por sitemap.xml e robots.txt (deve ser a URL pública do web)
# Prod: https://workdeal.co.mz | Sandbox: https://sandbox.workdeal.co.mz
NEXT_PUBLIC_SITE_URL=https://workdeal.co.mz
