{
  "name": "workdeal-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "pnpm --filter @workdeal/api scrape",
    "scrape:watch": "pnpm --filter @workdeal/api scrape:watch",
    "scrape:refetch": "pnpm --filter @workdeal/api scrape:refetch",
    "extract:ugeas": "pnpm --filter @workdeal/api extract:ugeas",
    "extract:ugeas-db": "pnpm --filter @workdeal/api extract:ugeas-db"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "playwright": "1.62.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
